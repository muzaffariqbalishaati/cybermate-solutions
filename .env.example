# ===========================
# CyberMate Solutions - Environment Variables
# ===========================

# ----------------------------
# DATABASE (Supabase PostgreSQL)
# ----------------------------
# Connect to Supabase via connection pooler (Transaction mode with pgbouncer):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations & schema push:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ----------------------------
# SUPABASE API (Storage & Realtime)
# ----------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----------------------------
# AUTHENTICATION
# ----------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
JWT_SECRET="your-jwt-secret-key-change-in-production-min-32-chars"

# ----------------------------
# EMAIL (SMTP)
# ----------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="CyberMate Solutions <noreply@cybermatesolutions.com>"

# ----------------------------
# RAZORPAY
# ----------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ----------------------------
# FILE STORAGE
# (Set STORAGE_PROVIDER to 'local' for local filesystem or 's3' for S3-compatible)
# ----------------------------
STORAGE_PROVIDER="local"
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"

# For S3/R2 (when STORAGE_PROVIDER=s3)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_PUBLIC_URL=""

# ----------------------------
# APPLICATION
# ----------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CyberMate Solutions"
NODE_ENV="development"

# ----------------------------
# RATE LIMITING
# ----------------------------
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ----------------------------
# REFERRAL SYSTEM
# ----------------------------
REFERRAL_REWARD_AMOUNT="100"
REFERRAL_REWARD_CURRENCY="INR"

# ----------------------------
# TAX SETTINGS
# ----------------------------
TAX_ENABLED="false"
TAX_RATE="18"
TAX_NAME="GST"

# ----------------------------
# CERTIFICATE
# ----------------------------
CERTIFICATE_ISSUER="CyberMate Solutions Learning Platform"
VERIFY_BASE_URL="http://localhost:3000/verify"
